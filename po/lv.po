#: ipaserver/plugins/internal.py:2009
msgid ""
"<h1>Unable to verify your Kerberos credentials</h1>\n"
"<p>\n"
"            Please make sure that you have valid Kerberos tickets "
"(obtainable via <strong>kinit</strong>), and that you have configured your "
"browser correctly.\n"
"</p>\n"
"\n"
"<h2>Browser configuration</h2>\n"
"\n"
"<div id=\"first-time\">\n"
"<p>\n"
"                If this is your first time, please <a "
"href=\"ssbrowser.html\">configure your browser</a>.\n"
"</p>\n"
"</div>\n"
msgstr ""
"<h1>Neizdevās pārbaudīt jūsu Kerberos akreditācijas datus</h1>\n"
"<p>\n"
"            Lūdzu, pārliecinieties, ka jums ir derīgas Kerberos biļetes "
"(iegūstamas ar <strong>kinit</strong>) un pārlūks ir pareizi konfigurēts.\n"
"</p>\n"
"\n"
"<h2>Pārlūka konfigurācija</h2>\n"
"\n"
