msgstr ""
"pārsūtīšanas zona „%(fwzone)s” nedarbojas, jo autoritatīvajā zonā „%"
"(authzone)s” trūkst pareizas NS deleģēšanas. Lūdzu, pievienojiet NS ierakstu "
"„%(ns_rec)s” vecākzonai „%(authzone)s”."

#: ipalib/messages.py:238
#, python-format
msgid ""
"DNS server %(server)s does not support EDNS0 (RFC 6891): %(error)s.\n"
"If DNSSEC validation is enabled on IPA server(s), please disable it."
msgstr ""
"DNS serveris %(server)s neatbalsta EDNS0 (RFC 6891): %(error)s.\n"
"Ja IPA serverī(-os) ir iespējota DNSSEC validēšana, lūdzu, atspējojiet to."

#: ipalib/messages.py:251
#, python-format
