"   ipa subid-generate\n"
"\n"
" Automātiski piešķirt lietotājam alice pakārtoto ID diapazonu:\n"
"   ipa subid-generate --owner=alice\n"
"\n"
" Atrast lietotāja alice pakārtotos ID:\n"
"   ipa subid-find --owner=alice\n"
"\n"
" Atrast ierakstu pēc jebkura pakārtotā uid diapazonā:\n"
"   ipa subid-match --subuid=2147483649\n"

