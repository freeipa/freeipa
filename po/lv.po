#: ipaserver/plugins/internal.py:1801
msgid ""
"<h1>Browser Kerberos Setup</h1>\n"
"\n"
msgstr ""
"<h1>Pārlūka Kerberos iestatīšana</h1>\n"
"\n"

#: ipaserver/plugins/internal.py:1805
msgid ""
"<h2>Firefox</h2>\n"
"\n"
"<p>\n"
"            You can configure Firefox to use Kerberos for Single Sign-on. "
"The following instructions will guide you in configuring your web browser to "
"send your Kerberos credentials to the appropriate Key Distribution Center "
"which enables Single Sign-on.\n"
"</p>\n"
"\n"
msgstr ""
"<h2>Firefox</h2>\n"
"\n"
"<p>\n"
"            Firefox var konfigurēt, lai vienotajai pierakstīšanās sistēmai "
"(Single Sign-on) izmantotu Kerberos. Šie norādījumi palīdzēs konfigurēt "
"tīmekļa pārlūku, lai tas sūtītu jūsu Kerberos akreditācijas datus "
"atbilstošajam atslēgu izplatīšanas centram, kas nodrošina vienoto "
"pierakstīšanos.\n"
"</p>\n"
"\n"

#: ipaserver/plugins/internal.py:1817
msgid ""
"<ol>\n"
"<li>\n"
"<p>\n"
"<a href=\"ca.crt\" id=\"ca-link\" class=\"btn btn-default\">Import "
"Certificate Authority certificate</a>\n"
"</p>\n"
"<p>\n"
"                    Make sure you select <b>all three</b> checkboxes.\n"
"</p>\n"
"</li>\n"
"<li>\n"
"                In the address bar of Firefox, type <code>about:config</"
"code> to display the list of current configuration options.\n"
"</li>\n"
"<li>\n"
"                In the Filter field, type <code>negotiate</code> to restrict "
"the list of options.\n"
"</li>\n"
"<li>\n"
"                Double-click the <code>network.negotiate-auth.trusted-uris</"
"code> entry to display the Enter string value dialog box.\n"
"</li>\n"
"<li>\n"
"                Enter the name of the domain against which you want to "
"authenticate, for example, <code class=\"example-domain\">.example.com</"
"code>.\n"
"</li>\n"
"<li><a href=\"../ui/index.html\" id=\"return-link\" class=\"btn btn-"
"default\">Return to Web UI</a></li>\n"
"</ol>\n"
"\n"
msgstr ""
"<ol>\n"
"<li>\n"
"<p>\n"
"<a href=\"ca.crt\" id=\"ca-link\" class=\"btn btn-default\">Importēt "
"sertificēšanas iestādes sertifikātu</a>\n"
"</p>\n"
"<p>\n"
"                    Noteikti atzīmējiet <b>visas trīs</b> izvēles rūtiņas.\n"
"</p>\n"
"</li>\n"
"<li>\n"
"                Firefox adreses joslā ierakstiet <code>about:config</code>, "
"lai parādītu pašreizējo konfigurācijas opciju sarakstu.\n"
"</li>\n"
"<li>\n"
"                Laukā „Filtrs” ierakstiet <code>negotiate</code>, lai "
"ierobežotu opciju sarakstu.\n"
"</li>\n"
"<li>\n"
"                Veiciet dubultklikšķi uz ieraksta <code>network.negotiate-"
"auth.trusted-uris</code>, lai parādītu virknes vērtības ievadīšanas "
"dialoglodziņu.\n"
"</li>\n"
"<li>\n"
"                Ievadiet domēna nosaukumu, pret kuru vēlaties "
"autentificēties, piemēram, <code class=\"example-domain\">.example.com</code>"
".\n"
"</li>\n"
"<li><a href=\"../ui/index.html\" id=\"return-link\" class=\"btn btn-"
"default\">Atgriezties tīmekļa saskarnē</a></li>\n"
"</ol>\n"
"\n"

#: ipaserver/plugins/internal.py:1853
msgid ""
"<h2>Chrome</h2>\n"
"\n"
"<p>\n"
"            You can configure Chrome to use Kerberos for Single Sign-on. The "
"following instructions will guide you in configuring your web browser to "
"send your Kerberos credentials to the appropriate Key Distribution Center "
"which enables Single Sign-on.\n"
"</p>\n"
"\n"
msgstr ""
"<h2>Chrome</h2>\n"
"\n"
"<p>\n"
"            Chrome var konfigurēt, lai vienotajai pierakstīšanās sistēmai "
"(Single Sign-on) izmantotu Kerberos. Šie norādījumi palīdzēs konfigurēt "
"tīmekļa pārlūku, lai tas sūtītu jūsu Kerberos akreditācijas datus "
"atbilstošajam atslēgu izplatīšanas centram, kas nodrošina vienoto "
"pierakstīšanos.\n"
"</p>\n"
"\n"

#: ipaserver/plugins/internal.py:1865
msgid ""
"<h3>Import CA Certificate</h3>\n"
"<ol>\n"
"<li>\n"
"                Download the <a href=\"ca.crt\">CA certificate</a>. "
"Alternatively, if the host is also an IdM client, you can find the "
"certificate in /etc/ipa/ca.crt.\n"
"</li>\n"
"<li>\n"
"                Click the menu button with the <em>Customize and control "
"Google Chrome</em> tooltip, which is by default in the top right-hand corner "
"of Chrome, and click <em>Settings</em>.\n"
"</li>\n"
"<li>\n"
"                Click <em>Show advanced settings</em> to display more "
"options, and then click the <em>Manage certificates</em> button located "
"under the HTTPS/SSL heading.\n"
"</li>\n"
"<li>\n"
"                In the <em>Authorities</em> tab, click the <em>Import</em> "
"button at the bottom.\n"
"</li>\n"
"<li>Select the CA certificate file that you downloaded in the first step.</"
"li>\n"
"</ol>\n"
"\n"
msgstr ""
"<h3>Importēt CA sertifikātu</h3>\n"
"<ol>\n"
"<li>\n"
"                Lejupielādējiet <a href=\"ca.crt\">CA sertifikātu</a>. Ja "
"resursdators ir arī IdM klients, sertifikātu var atrast arī /etc/ipa/"
"ca.crt.\n"
"</li>\n"
"<li>\n"
"                Noklikšķiniet uz izvēlnes pogas ar paskaidri <em>Customize "
"and control Google Chrome</em>, kas pēc noklusējuma atrodas Chrome augšējā "
"labajā stūrī, un noklikšķiniet uz <em>Settings</em>.\n"
"</li>\n"
"<li>\n"
"                Noklikšķiniet uz <em>Show advanced settings</em>, lai "
"parādītu vairāk opciju, un tad noklikšķiniet uz pogas <em>Manage "
"certificates</em>, kas atrodas zem virsraksta HTTPS/SSL.\n"
"</li>\n"
"<li>\n"
"                Cilnē <em>Authorities</em> apakšā noklikšķiniet uz pogas <em>"
"Import</em>.\n"
"</li>\n"
"<li>Atlasiet CA sertifikāta failu, ko lejupielādējāt pirmajā solī.</li>\n"
"</ol>\n"
"\n"

#: ipaserver/plugins/internal.py:1894
msgid ""
"<h3>\n"
"            Enable SPNEGO (Simple and Protected GSSAPI Negotiation "
"Mechanism) to Use Kerberos Authentication\n"
"            in Chrome\n"
"</h3>\n"
"<ol>\n"
"<li>\n"
"                Make sure you have the necessary directory created by "
"running:\n"
"<div><code>\n"
"                    [root@client]# mkdir -p /etc/opt/chrome/policies/"
"managed/\n"
"</code></div>\n"
"</li>\n"
"<li>\n"
"                Create a new <code>/etc/opt/chrome/policies/managed/"
"mydomain.json</code> file with write privileges limited to the system "
"administrator or root, and include the following line:\n"
"<div><code>\n"
"                    { \"AuthServerWhitelist\": \"*<span class=\"example-"
"domain\">.example.com</span>\" }\n"
"</code></div>\n"
"<div>\n"
"                    You can do this by running:\n"
"</div>\n"
"<div><code>\n"
"                    [root@server]# echo '{ \"AuthServerWhitelist\": \"*<span "
"class=\"example-domain\">.example.com</span>\" }' > /etc/opt/chrome/policies/"
"managed/mydomain.json\n"
"</code></div>\n"
"</li>\n"
"</ol>\n"
"<ol>\n"
"<p>\n"
"<strong>Note:</strong> If using Chromium, use <code>/etc/chromium/policies/"
"managed/</code> instead of <code>/etc/opt/chrome/policies/managed/</code> "
"for the two SPNEGO Chrome configuration steps above.\n"
"</p>\n"
"</ol>\n"
"\n"
msgstr ""
"<h3>\n"
"            Iespējot SPNEGO (Simple and Protected GSSAPI Negotiation "
"Mechanism), lai izmantotu Kerberos autentifikāciju\n"
"            pārlūkā Chrome\n"
"</h3>\n"
"<ol>\n"
"<li>\n"
"                Pārliecinieties, ka nepieciešamā direktorija ir izveidota, "
"palaižot:\n"
"<div><code>\n"
"                    [root@client]# mkdir -p /etc/opt/chrome/policies/managed/"
"\n"
"</code></div>\n"
"</li>\n"
"<li>\n"
"                Izveidojiet jaunu failu <code>/etc/opt/chrome/policies/"
"managed/mydomain.json</code> ar rakstīšanas tiesībām, kas ierobežotas ar "
"sistēmas administratoru vai root, un iekļaujiet tajā šādu rindu:\n"
"<div><code>\n"
"                    { \"AuthServerWhitelist\": \"*<span class=\"example-"
"domain\">.example.com</span>\" }\n"
"</code></div>\n"
"<div>\n"
"                    To var izdarīt, palaižot:\n"
"</div>\n"
"<div><code>\n"
"                    [root@server]# echo '{ \"AuthServerWhitelist\": \"*<span "
"class=\"example-domain\">.example.com</span>\" }' > /etc/opt/chrome/policies/"
"managed/mydomain.json\n"
"</code></div>\n"
"</li>\n"
"</ol>\n"
"<ol>\n"
"<p>\n"
"<strong>Piezīme:</strong> ja izmantojat Chromium, abiem iepriekš minētajiem "
"SPNEGO Chrome konfigurēšanas soļiem <code>/etc/opt/chrome/policies/managed/</"
"code> vietā izmantojiet <code>/etc/chromium/policies/managed/</code>.\n"
"</p>\n"
"</ol>\n"
"\n"

#: ipaserver/plugins/internal.py:1939
msgid ""
"<h2>Internet Explorer</h2>\n"
"<p><strong>WARNING:</strong> Internet Explorer is no longer a supported "
"browser.</p>\n"
"<p>\n"
"            Once you are able to log into the workstation with your kerberos "
"key you are now able to use that ticket in Internet Explorer.\n"
"</p>\n"
"<p>\n"
msgstr ""
"<h2>Internet Explorer</h2>\n"
"<p><strong>BRĪDINĀJUMS:</strong> Internet Explorer vairs nav atbalstīts "
"pārlūks.</p>\n"
"<p>\n"
"            Kad varat pieteikties darbstacijā ar savu kerberos atslēgu, šo "
"biļeti varat izmantot arī pārlūkā Internet Explorer.\n"
"</p>\n"
"<p>\n"

#: ipaserver/plugins/internal.py:1950
msgid ""
"<strong>Log into the Windows machine using an account of your Kerberos realm "
"(administrative domain)</strong>\n"
"</p>\n"
"<p>\n"
"<strong>In Internet Explorer, click Tools, and then click Internet Options.</"
"strong>\n"
"</p>\n"
"<div>\n"
"<ol>\n"
"<li>Click the Security tab</li>\n"
"<li>Click Local intranet</li>\n"
"<li>Click Sites </li>\n"
"<li>Click Advanced </li>\n"
"<li>Add your domain to the list</li>\n"
"</ol>\n"
"<ol>\n"
"<li>Click the Security tab</li>\n"
"<li>Click Local intranet</li>\n"
"<li>Click Custom Level</li>\n"
"<li>Select Automatic logon only in Intranet zone</li>\n"
"</ol>\n"
"\n"
"<ol>\n"
"<li> Visit a kerberized web site using IE (You must use the fully-qualified "
"Domain Name in the URL)</li>\n"
"<li><strong> You are all set.</strong></li>\n"
"</ol>\n"
"</div>\n"
"\n"
msgstr ""
"<strong>Piesakieties Windows datorā, izmantojot savas Kerberos realm "
"(administratīvā domēna) kontu</strong>\n"
"</p>\n"
"<p>\n"
"<strong>Pārlūkā Internet Explorer noklikšķiniet uz Tools un tad uz Internet "
"Options.</strong>\n"
"</p>\n"
"<div>\n"
"<ol>\n"
"<li>Noklikšķiniet uz cilnes Security</li>\n"
"<li>Noklikšķiniet uz Local intranet</li>\n"
"<li>Noklikšķiniet uz Sites </li>\n"
"<li>Noklikšķiniet uz Advanced </li>\n"
"<li>Pievienojiet sarakstam savu domēnu</li>\n"
"</ol>\n"
"<ol>\n"
"<li>Noklikšķiniet uz cilnes Security</li>\n"
"<li>Noklikšķiniet uz Local intranet</li>\n"
"<li>Noklikšķiniet uz Custom Level</li>\n"
"<li>Atlasiet Automatic logon only in Intranet zone</li>\n"
"</ol>\n"
"\n"
"<ol>\n"
"<li> Atveriet tīmekļa vietni ar kerberos atbalstu, izmantojot IE (URL "
"jāizmanto pilnībā kvalificēts domēna nosaukums)</li>\n"
"<li><strong> Viss ir gatavs.</strong></li>\n"
"</ol>\n"
"</div>\n"
"\n"

