#: ipaserver/plugins/internal.py:1801
msgid ""
"<h1>Browser Kerberos Setup</h1>\n"
"\n"
msgstr ""
"<h1>Configuració del navegador Kerberos</h1>\n"
"\n"

#: ipaserver/plugins/internal.py:1805
msgid ""
"<h2>Firefox</h2>\n"
"\n"
"<p>\n"
"            You can configure Firefox to use Kerberos for Single Sign-on. "
"The following instructions will guide you in configuring your web browser to "
"send your Kerberos credentials to the appropriate Key Distribution Center "
"which enables Single Sign-on.\n"
"</p>\n"
"\n"
msgstr ""
"<h2>Firefox</h2>\n"
"\n"
"<p>\n"
"            Podeu configurar el Firefox per a utilitzar Kerberos per a un "
"inici de sessió únic. Les següents instruccions us guiaran en la "
"configuració del vostre navegador web per enviar les vostres credencials "
"Kerberos al Centre de Distribució de Clau apropiat que permet l'inici de "
"sessió únic.\n"
"</p>\n"
"\n"

#: ipaserver/plugins/internal.py:1817
msgid ""
"<ol>\n"
"<li>\n"
"<p>\n"
"<a href=\"ca.crt\" id=\"ca-link\" class=\"btn btn-default\">Import "
"Certificate Authority certificate</a>\n"
"</p>\n"
"<p>\n"
"                    Make sure you select <b>all three</b> checkboxes.\n"
"</p>\n"
"</li>\n"
"<li>\n"
"                In the address bar of Firefox, type <code>about:config</"
"code> to display the list of current configuration options.\n"
"</li>\n"
"<li>\n"
"                In the Filter field, type <code>negotiate</code> to restrict "
"the list of options.\n"
"</li>\n"
"<li>\n"
"                Double-click the <code>network.negotiate-auth.trusted-uris</"
"code> entry to display the Enter string value dialog box.\n"
"</li>\n"
"<li>\n"
"                Enter the name of the domain against which you want to "
"authenticate, for example, <code class=\"example-domain\">.example.com</"
"code>.\n"
"</li>\n"
"<li><a href=\"../ui/index.html\" id=\"return-link\" class=\"btn btn-"
"default\">Return to Web UI</a></li>\n"
"</ol>\n"
"\n"
msgstr ""
"<ol>\n"
"<li>\n"
"<p>\n"
"<a href=\"ca.crt\" id=\"ca-link\" class=\"btn btn-default\">Importa "
"certificat d'autoritat</a>\n"
"</p>\n"
"<p>\n"
"                    Assegureu-vos de seleccionar <b>totes les tres caselles "
"de selecció</b>.\n"
"</p>\n"
"</li>\n"
"<li>\n"
"                A la barra d'adreces del Firefox, escriviu <code>"
"about:config</code> per mostrar la llista d'opcions de configuració "
"actuals.\n"
"</li>\n"
"<li>\n"
"                Al camp Filtre, tipus <code>negociar</code> per restringir "
"la llista d'opcions.\n"
"</li>\n"
"<li>\n"
"                Feu doble clic a l'entrada <code>network.negotiate-"
"auth.trusted-uris</code> per a mostrar el diàleg Introduïu el valor de la "
"cadena.\n"
"</li>\n"
"<li>\n"
"                Introduïu el nom del domini contra el qual voleu autenticar, "
"per exemple, <code class=\"example-domain\">.example.com</code>.\n"
"</li>\n"
"<li><a href=\"../ui/index.html\" id=\"return-link\" class=\"btn btn-"
"default\">Retorna a la interfície web</a></li>\n"
"</ol>\n"
"\n"

#: ipaserver/plugins/internal.py:1853
msgid ""
"<h2>Chrome</h2>\n"
"\n"
"<p>\n"
"            You can configure Chrome to use Kerberos for Single Sign-on. The "
"following instructions will guide you in configuring your web browser to "
"send your Kerberos credentials to the appropriate Key Distribution Center "
"which enables Single Sign-on.\n"
"</p>\n"
"\n"
msgstr ""
"<h2>Chrome</h2>\n"
"\n"
"<p>\n"
"            Podeu configurar Chrome per utilitzar Kerberos per a un inici de "
"sessió únic. Les següents instruccions us guiaran en la configuració del "
"vostre navegador web per enviar les vostres credencials Kerberos al Centre "
"de Distribució de Clau apropiat que permet l'inici de sessió únic.\n"
"</p>\n"
"\n"

#: ipaserver/plugins/internal.py:1865
msgid ""
"<h3>Import CA Certificate</h3>\n"
"<ol>\n"
"<li>\n"
"                Download the <a href=\"ca.crt\">CA certificate</a>. "
"Alternatively, if the host is also an IdM client, you can find the "
"certificate in /etc/ipa/ca.crt.\n"
"</li>\n"
"<li>\n"
"                Click the menu button with the <em>Customize and control "
"Google Chrome</em> tooltip, which is by default in the top right-hand corner "
"of Chrome, and click <em>Settings</em>.\n"
"</li>\n"
"<li>\n"
"                Click <em>Show advanced settings</em> to display more "
"options, and then click the <em>Manage certificates</em> button located "
"under the HTTPS/SSL heading.\n"
"</li>\n"
"<li>\n"
"                In the <em>Authorities</em> tab, click the <em>Import</em> "
"button at the bottom.\n"
"</li>\n"
"<li>Select the CA certificate file that you downloaded in the first step.</"
"li>\n"
"</ol>\n"
"\n"
msgstr ""
"<h3>Importa el certificat CA</h3>\n"
"<ol>\n"
"<li>\n"
"                Baixeu el certificat CA <a href=\"ca.crt\"></a>. "
"Alternativament, si l'amfitrió també és client IdM, podeu trobar el "
"certificat a /etc/ipa/ca.crt.\n"
"</li>\n"
"<li>\n"
"                Feu clic al botó de menú amb el <em>Personalitza i controla "
"Google Chrome</em> tooltip, que és per defecte a la cantonada superior dreta "
"de Chrome, i feu clic a <em>Configuració</em>.\n"
"</li>\n"
"<li>\n"
"                Feu clic a <em>Mostra la configuració avançada</em> per "
"mostrar més opcions i, a continuació, feu clic al botó <em>Gestiona els "
"certificats</em> situat sota l'encapçalament HTTPS/SSL.\n"
"</li>\n"
"<li>\n"
"                A la pestanya <em>Authorities</em>, feu clic al botó <em>"
"Importa</em> a la part inferior.\n"
"</li>\n"
"<li>Seleccioneu el fitxer de certificat de la CA que heu baixat en el primer "
"pas.</li>\n"
"</ol>\n"
"\n"

#: ipaserver/plugins/internal.py:1894
msgid ""
"<h3>\n"
"            Enable SPNEGO (Simple and Protected GSSAPI Negotiation "
"Mechanism) to Use Kerberos Authentication\n"
"            in Chrome\n"
"</h3>\n"
"<ol>\n"
"<li>\n"
"                Make sure you have the necessary directory created by "
"running:\n"
"<div><code>\n"
"                    [root@client]# mkdir -p /etc/opt/chrome/policies/"
"managed/\n"
"</code></div>\n"
"</li>\n"
"<li>\n"
"                Create a new <code>/etc/opt/chrome/policies/managed/"
"mydomain.json</code> file with write privileges limited to the system "
"administrator or root, and include the following line:\n"
"<div><code>\n"
"                    { \"AuthServerWhitelist\": \"*<span class=\"example-"
"domain\">.example.com</span>\" }\n"
"</code></div>\n"
"<div>\n"
"                    You can do this by running:\n"
"</div>\n"
"<div><code>\n"
"                    [root@server]# echo '{ \"AuthServerWhitelist\": \"*<span "
"class=\"example-domain\">.example.com</span>\" }' > /etc/opt/chrome/policies/"
"managed/mydomain.json\n"
"</code></div>\n"
"</li>\n"
"</ol>\n"
"<ol>\n"
"<p>\n"
"<strong>Note:</strong> If using Chromium, use <code>/etc/chromium/policies/"
"managed/</code> instead of <code>/etc/opt/chrome/policies/managed/</code> "
"for the two SPNEGO Chrome configuration steps above.\n"
"</p>\n"
"</ol>\n"
"\n"
msgstr ""
"<h3>\n"
"            Habilita SPNEGO (mecanisme de negociació simple i protegit "
"GSSAPI) per utilitzar l'autenticació Kerberos\n"
"            a Chrome\n"
"</h3>\n"
"<ol>\n"
"<li>\n"
"                Assegureu-vos que teniu el directori necessari creat "
"executant:\n"
"<div><code>\n"
"                    [root]client]] mkdir -p /etc/opt/chrome/policies/"
"gestionat/\n"
"</code></div>\n"
"</li>\n"
"<li>\n"
"                Crea un fitxer <code>/etc/opt/chrome/policies/managed/"
"mydomain.json</code> amb privilegis d'escriptura limitats a l'administrador "
"del sistema o root, i inclou la següent línia:\n"
"<div><code>\n"
"                    { \"AuthServerWhitelist\": \"*<span class=\"example-"
"domain\">.example.com</span>\" }\n"
"</code></div>\n"
"<div>\n"
"                    Podeu fer-ho executant:\n"
"</div>\n"
"<div><code>\n"
"                    [root.server]: echo '{ \"AuthServerWhitelist\": \"*<span "
"class=\"example-domain\">.example.com</span>\" }'   /etc/opt/chrome/policies/"
"managed/mydomain.json\n"
"</code></div>\n"
"</li>\n"
"</ol>\n"
"<ol>\n"
"<p>\n"
"<strong>Nota:</strong> Si utilitzeu Chromium, utilitzeu <code>/etc/chromium/"
"policies/managed/</code> en lloc de <code>/etc/opt/chrome/policies/managed/</"
"code> per als dos passos de configuració de SPNEGO Chrome anteriors.\n"
"</p>\n"
"</ol>\n"
"\n"

#: ipaserver/plugins/internal.py:1939
msgid ""
"<h2>Internet Explorer</h2>\n"
"<p><strong>WARNING:</strong> Internet Explorer is no longer a supported "
"browser.</p>\n"
"<p>\n"
"            Once you are able to log into the workstation with your kerberos "
"key you are now able to use that ticket in Internet Explorer.\n"
"</p>\n"
"<p>\n"
msgstr ""
"<h2>Internet Explorer</h2>\n"
"<p><strong>AVÍS:</strong> Internet Explorer ja no és un navegador "
"compatible.</p>\n"
"<p>\n"
"            Una vegada que vostè és capaç d'entrar a l'estació de treball "
"amb la seva clau de kerberos ara és capaç d'utilitzar aquest bitllet a "
"Internet Explorer.\n"
"</p>\n"
"<p>\n"

#: ipaserver/plugins/internal.py:1950
msgid ""
"<strong>Log into the Windows machine using an account of your Kerberos realm "
"(administrative domain)</strong>\n"
"</p>\n"
"<p>\n"
"<strong>In Internet Explorer, click Tools, and then click Internet Options.</"
"strong>\n"
"</p>\n"
"<div>\n"
"<ol>\n"
"<li>Click the Security tab</li>\n"
"<li>Click Local intranet</li>\n"
"<li>Click Sites </li>\n"
"<li>Click Advanced </li>\n"
"<li>Add your domain to the list</li>\n"
"</ol>\n"
"<ol>\n"
"<li>Click the Security tab</li>\n"
"<li>Click Local intranet</li>\n"
"<li>Click Custom Level</li>\n"
"<li>Select Automatic logon only in Intranet zone</li>\n"
"</ol>\n"
"\n"
"<ol>\n"
"<li> Visit a kerberized web site using IE (You must use the fully-qualified "
"Domain Name in the URL)</li>\n"
"<li><strong> You are all set.</strong></li>\n"
"</ol>\n"
"</div>\n"
"\n"
msgstr ""
"<strong>Inicieu sessió a la màquina Windows utilitzant un compte del vostre "
"reialme de Kerberos (domini administratiu)</strong>\n"
"</p>\n"
"<p>\n"
"<strong>A Internet Explorer, feu clic a Eines i, a continuació, feu clic a "
"Opcions d'Internet.</strong>\n"
"</p>\n"
"<div>\n"
"<ol>\n"
"<li>Feu clic a la pestanya Seguretat</li>\n"
"<li>Feu clic a la intranet local</li>\n"
"<li>Click Sites </li>\n"
"<li>Click Advanced </li>\n"
"<li>Afegeix el teu domini a la llista</li>\n"
"</ol>\n"
"<ol>\n"
"<li>Feu clic a la pestanya Seguretat</li>\n"
"<li>Feu clic a la intranet local</li>\n"
"<li>Feu clic al nivell personalitzat</li>\n"
"<li>Selecciona l'inici automàtic només a la zona d'intranet</li>\n"
"</ol>\n"
"\n"
"<ol>\n"
"<li> Visita un lloc web querberitzat utilitzant IE (Heu d'utilitzar el nom "
"de domini completament qualificat a la URL)</li>\n"
"<li><strong> Esteu tots configurats.</strong></li>\n"
"</ol>\n"
"</div>\n"
"\n"

