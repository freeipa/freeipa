#: ipaserver/plugins/subid.py:29
msgid ""
"\n"
"Subordinate ids\n"
"\n"
"Manage subordinate user and group ids for users\n"
"\n"
"EXAMPLES:\n"
"\n"
" Auto-assign a subordinate id range to current user\n"
"   ipa subid-generate\n"
"\n"
" Auto-assign a subordinate id range to user alice:\n"
"   ipa subid-generate --owner=alice\n"
"\n"
" Find subordinate ids for user alice:\n"
"   ipa subid-find --owner=alice\n"
"\n"
" Match entry by any subordinate uid in range:\n"
"   ipa subid-match --subuid=2147483649\n"
msgstr ""
"\n"
"Id de subordina\n"
"\n"
"Gestiona els ID d'usuari i grup subordinats per als usuaris\n"
"\n"
"EXEMPLES:\n"
"\n"
" Assigna automàticament un interval d'id subordinat a l'usuari actual\n"
"   ipa subid-generate\n"
"\n"
" Assigna automàticament un interval d'id subordinat a l'alícia de l'usuari:\n"
"   ipa subid-generate --owner-alice\n"
"\n"
" Troba els ID subordinats per a l'alícia de l'usuari:\n"
"   ipa subid-find --owner-alice\n"
"\n"
" Concorda amb l'entrada per qualsevol UID subordinat en l'interval:\n"
"   ipa subid-match --subuid-2147483649\n"

