"delegação NS apropriada em zona autoritativa \"%(authzone)s\". Por favor "
"adicione registo NS \"%(ns_rec)s\" na zona pai \"%(authzone)s\"."

#: ipalib/messages.py:238
#, python-format
msgid ""
"DNS server %(server)s does not support EDNS0 (RFC 6891): %(error)s.\n"
"If DNSSEC validation is enabled on IPA server(s), please disable it."
msgstr ""
"Servidor DNS %(server)s não suporta EDNS0 (RFC 6891): %(error)s.\n"
"Se a validação DNSSEC estiver ativa nos servidores IPA, por favor desative-a."

#: ipalib/messages.py:251
#, python-format
msgid ""
"DNSSEC validation failed: %(error)s.\n"
"Please verify your DNSSEC configuration or disable DNSSEC validation on all "
"IPA servers."
msgstr ""
"Validação DNSSEC falhou: %(error)s.\n"
"Por favor verifique a sua configuração DNSSEC ou desative a validação DNSSEC "
"em todos os servidores IPA."

#: ipalib/messages.py:265
#, python-format
msgid ""
"The _kerberos TXT record from domain %(domain)s could not be created "
