"     de acordos de replicação\n"

#: ipaserver/plugins/subid.py:29
msgid ""
"\n"
"Subordinate ids\n"
"\n"
"Manage subordinate user and group ids for users\n"
"\n"
"EXAMPLES:\n"
"\n"
" Auto-assign a subordinate id range to current user\n"
"   ipa subid-generate\n"
"\n"
" Auto-assign a subordinate id range to user alice:\n"
"   ipa subid-generate --owner=alice\n"
"\n"
" Find subordinate ids for user alice:\n"
"   ipa subid-find --owner=alice\n"
"\n"
" Match entry by any subordinate uid in range:\n"
"   ipa subid-match --subuid=2147483649\n"
msgstr ""
"\n"
"Ids subordinados\n"
"\n"
"Gerir ids de utilizador e grupo subordinado para utilizadores\n"
"\n"
"EXEMPLOS:\n"
"\n"
" Auto-atribuir uma gama de id subordinado ao utilizador atual\n"
"   ipa subid-generate\n"
"\n"
" Auto-atribuir uma gama de id subordinado ao utilizador alice:\n"
"   ipa subid-generate --owner=alice\n"
"\n"
" Encontrar ids subordinados para o utilizador alice:\n"
"   ipa subid-find --owner=alice\n"
"\n"
" corresponde entrada por qualquer uid subordinado na gama:\n"
"   ipa subid-match --subuid=2147483649\n"

